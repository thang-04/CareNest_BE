{
  "info": {
    "name": "CareNest - CRUD giáo viên",
    "description": "Chọn environment 'CareNest Local' rồi chạy lần lượt 1 -> 16 (hoặc Run collection). Token và id tự lưu vào environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login Hiệu trưởng",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let b = {}; try { b = pm.response.json(); } catch (e) {}",
              "const d = b.data;",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('code = 0', () => pm.expect(b.code).to.eql(0));",
              "pm.environment.set('principalToken', d.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Client-Type",
            "value": "mobile"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{principalEmail}}\",\n  \"password\": \"{{principalPassword}}\"\n}"
        }
      }
    },
    {
      "name": "2. Tạo giáo viên",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// New email/phone each run so the request can be sent again.",
              "const n = String(Date.now()).slice(-8);",
              "pm.environment.set('teacherEmail', 'gv' + n + '@gmail.com');",
              "pm.environment.set('teacherPhone', '07' + n);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let b = {}; try { b = pm.response.json(); } catch (e) {}",
              "const d = b.data;",
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('code = 0', () => pm.expect(b.code).to.eql(0));",
              "pm.test('role TEACHER', () => pm.expect(d.roles).to.eql(['TEACHER']));",
              "pm.test('bắt đổi mật khẩu', () => pm.expect(d.mustChangePassword).to.be.true);",
              "pm.environment.set('teacherId', d.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Client-Type",
            "value": "mobile"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{principalToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/management/staff",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "management",
            "staff"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{teacherEmail}}\",\n  \"fullName\": \"Cô Lan\",\n  \"phoneNumber\": \"{{teacherPhone}}\",\n  \"password\": \"{{teacherPassword}}\",\n  \"role\": \"TEACHER\",\n  \"position\": \"Giáo viên lớp Mầm\"\n}"
        }
      }
    },
