#!/bin/sh
# Kiểm commit message (<mã-jira>: <mô tả>, không AI attribution); nhánh sai định dạng chỉ cảnh báo. ADR-0012.
. "$(dirname "$0")/lib.sh"
cn_validate_msg "$1"
[ "$CN_ERRORS" -eq 0 ] || { echo "[CareNest] Commit bị chặn: sửa message rồi commit lại (xem AGENTS.md › Commit message)." >&2; exit 1; }
cn_check_branch
exit 0
