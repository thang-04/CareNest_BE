# Copy thành .env rồi điền giá trị. Không commit .env.

# PostgreSQL (compose)
POSTGRES_DB=carenest
POSTGRES_USER=carenest
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Ứng dụng (khi chạy ngoài compose: mvnw spring-boot:run)
DB_URL=jdbc:postgresql://localhost:5432/carenest
DB_USERNAME=carenest
DB_PASSWORD=change-me
SERVER_PORT=8080
API_PREFIX=/api

# Auth (JWT HS512, tối thiểu 64 ký tự)
JWT_SECRET=change-me-to-a-random-string-of-at-least-64-characters-0123456789abcdef

# Tài khoản Hiệu trưởng tạo lúc khởi động (bắt đổi mật khẩu ở lần đăng nhập đầu)
ADMIN_EMAIL=admin@carenest.com
ADMIN_PASSWORD=change-me

# Gửi OTP quên mật khẩu (Gmail: dùng App Password)
MAIL_USERNAME=
MAIL_PASSWORD=

# Lưu ảnh S3-compatible (service s3 trong compose; key phải khớp docker/s3.json)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=carenest
STORAGE_SECRET_KEY=carenest-secret
STORAGE_PORT=9000

# CORS cho web
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

