# Copy thành .env rồi điền giá trị. Không commit .env.
# Giá trị "change-me" chỉ để chạy được ngay ở máy dev; đổi hết khi lên server.

# PostgreSQL (compose)
POSTGRES_DB=carenest
POSTGRES_USER=carenest
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Ứng dụng (khi chạy ngoài compose: mvnw spring-boot:run)
DB_URL=jdbc:postgresql://localhost:5432/carenest
DB_USERNAME=carenest
DB_PASSWORD=change-me
SERVER_PORT=8080
API_PREFIX=/api
# Múi giờ trường: xác định "hôm nay" khi xét phân công/enrollment còn hiệu lực
CARENEST_TIME_ZONE=Asia/Ho_Chi_Minh
# dev = nạp dữ liệu giả (compose); chạy mvnw: mvnw.cmd spring-boot:run -Dspring-boot.run.profiles=dev
SPRING_PROFILES_ACTIVE=dev

# Keycloak (compose) — hướng dẫn: docs/system/KEYCLOAK.md
KEYCLOAK_PORT=8180
KEYCLOAK_HOSTNAME=http://localhost:8180
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
# Secret của client carenest-backend (gọi Keycloak Admin API); chuỗi ngẫu nhiên >= 32 ký tự
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-to-a-random-32-char-secret
CARENEST_WEB_ORIGIN=http://localhost:3000
CARENEST_MOBILE_REDIRECT_URI=carenest://oauth/callback
# Client carenest-dev (lấy token bằng password grant) — chỉ true ở máy dev, server thật để false
CARENEST_DEV_CLIENT_ENABLED=true
# Email Keycloak (đặt mật khẩu, OTP) dùng chung Gmail CARENEST_EMAIL_SMTP_* ở mục Email bên dưới

# Trợ lý AI (AI-09: Gemini hoặc Groq, endpoint OpenAI-compatible). Để trống khóa ⇒ AI tắt, nghiệp vụ vẫn chạy (AI-03)
# Groq: CARENEST_AI_BASE_URL=https://api.groq.com/openai/v1, CARENEST_AI_MODEL=<model Groq>
CARENEST_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CARENEST_AI_API_KEY=
CARENEST_AI_MODEL=gemini-2.0-flash

# Ứng dụng — xác thực JWT (khi chạy API ngoài compose)
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/carenest
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/carenest/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=carenest-api
# Client Keycloak (claim azp) ⇒ nền tảng (ADR-0022); client không khai báo bị 403 mọi API
CARENEST_WEB_CLIENT_IDS=carenest-auth-gateway,carenest-web
CARENEST_MOBILE_CLIENT_IDS=carenest-mobile
# Chỉ dev: profile dev mặc định carenest-dev
# CARENEST_DEV_CLIENT_IDS=carenest-dev
# Ứng dụng — cấp/khóa tài khoản qua Keycloak Admin API (khi chạy API ngoài compose; secret dùng chung ở trên)
KEYCLOAK_BASE_URL=http://localhost:8180
KEYCLOAK_REALM=carenest
KEYCLOAK_ADMIN_CLIENT_ID=carenest-backend
KEYCLOAK_ACTIONS_EMAIL_ENABLED=true
CARENEST_CORS_ALLOWED_ORIGINS=http://localhost:3000

# React auth gateway (ADR-0013), chỉ bật sau khi cài extension/bootstrap.
CARENEST_AUTH_ENABLED=false
CARENEST_AUTH_WEB_ORIGIN=http://localhost:5173
# Gateway secret ngẫu nhiên >=32 ký tự; hai khóa sau là 32 byte mã hóa base64, độc lập nhau.
KEYCLOAK_AUTH_GATEWAY_CLIENT_SECRET=
CARENEST_AUTH_ENCRYPTION_KEY=
KEYCLOAK_AUTH_RECOVERY_ASSERTION_SECRET=
# Chỉ đặt false khi thử HTTP trên localhost; môi trường HTTPS giữ true.
CARENEST_AUTH_SECURE_COOKIES=true

# Kho tệp S3 private dùng chung (ảnh, tài liệu, học liệu); xem docs/system/EDUCATION_MEDIA_S3.md
CARENEST_EDUCATION_MEDIA_BUCKET=
AWS_REGION=ap-southeast-1
CARENEST_EDUCATION_MEDIA_ENDPOINT=
CARENEST_EDUCATION_MEDIA_PATH_STYLE=false
# Liên kết xem/tải lên có hạn; giới hạn từng loại: CARENEST_STORAGE_MAX_* (xem application.yml › carenest.storage)
CARENEST_STORAGE_PRESIGN_TTL=15m
# Thư mục của tệp cũ (key UUID, trước spec 017) — chỉ đọc/xóa; tệp mới theo thư mục mới (avatars/, hoclieu/, meals/...)
CARENEST_EDUCATION_MEDIA_PREFIX=education/learning-resources/
CARENEST_ACCOUNT_MEDIA_PREFIX=accounts/photos/
CARENEST_SIGNATURE_MEDIA_PREFIX=accounts/signatures/
CARENEST_INSPECTION_SIGNATURE_MEDIA_PREFIX=meals/inspection-signatures/
# Credential đặt ngoài repo qua môi trường hoặc runtime role của AWS SDK.

# Email (docs/system/DEPLOYMENT.md mục Email): Gmail dùng cho cả Keycloak (trống ⇒ Keycloak gửi email thất bại)
# và BE (CARENEST_EMAIL_PROVIDER: log = không gửi thật; smtp = gửi qua Gmail)
# Gmail: bật xác minh 2 bước rồi tạo App Password (16 ký tự, bỏ dấu cách) — không dùng mật khẩu đăng nhập Gmail
CARENEST_EMAIL_PROVIDER=log
CARENEST_EMAIL_SMTP_USERNAME=
CARENEST_EMAIL_SMTP_PASSWORD=
# Trống ⇒ dùng CARENEST_EMAIL_SMTP_USERNAME
CARENEST_EMAIL_FROM=
CARENEST_EMAIL_FROM_NAME=CareNest
# Mặc định smtp.gmail.com:587 STARTTLS; đổi host/port để gửi qua SMTP khác
# CARENEST_EMAIL_SMTP_HOST=smtp.gmail.com
# CARENEST_EMAIL_SMTP_PORT=587
# CARENEST_EMAIL_SMTP_STARTTLS=true

# CHỈ DÙNG KHI DEV: thử kích hoạt năm học trước hạn 7 ngày / kết thúc năm đang hoạt động trước ngày kết thúc (mặc định tắt)
# CARENEST_DEV_ACTIVATION_SKIPDATEWINDOW=true
# CARENEST_DEV_ACTIVATION_SKIPCLOSEENDDATE=true
