# Mẫu .env cho VPS (compose.vps.yaml). Trên VPS: chép thành /data/thangnd/CAPSTONE/CareNest_BE/.env, điền giá trị, chmod 600.
# Không commit .env. Secret: chuỗi ngẫu nhiên (`openssl rand -base64 32`), không dùng lại giá trị của máy dev.
# API_IMAGE / KEYCLOAK_IMAGE do CI truyền khi deploy; chỉ đặt tay khi rollback (docs/system/DEPLOYMENT.md).

# PostgreSQL
POSTGRES_DB=carenest
POSTGRES_USER=carenest
POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# Keycloak
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
# Secret client carenest-backend (Admin API); >= 32 ký tự
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
# Mật khẩu chung 8 user demo (docker/keycloak/vps/carenest-users-0.json) — chỉ giai đoạn seed demo; đặt mạnh vì site ra
# Internet, >= 8 ký tự, khác username (chính sách realm). Chỉ áp khi Keycloak import realm lần đầu: realm đã có thì đổi
# mật khẩu trong admin console (docs/system/DEPLOYMENT.md)
KEYCLOAK_DEV_USER_PASSWORD=change-me
CARENEST_MOBILE_REDIRECT_URI=carenest://oauth/callback

# Email qua Resend SMTP (docs/system/DEPLOYMENT.md mục Email), dùng chung cho Keycloak và BE.
# BE: log = không gửi; smtp = gửi thật. Password = API key Resend; FROM thuộc domain đã xác minh
CARENEST_EMAIL_PROVIDER=log
CARENEST_EMAIL_SMTP_USERNAME=resend
CARENEST_EMAIL_SMTP_PASSWORD=
CARENEST_EMAIL_FROM=
CARENEST_EMAIL_FROM_NAME=CareNest
# VPS chặn 587 ⇒ 2587
# CARENEST_EMAIL_SMTP_PORT=587

# API
# dev = nạp dữ liệu giả; đặt rỗng (SPRING_PROFILES_ACTIVE=) khi chuyển dữ liệu thật
SPRING_PROFILES_ACTIVE=dev

# React auth gateway (ADR-0013): để false tới khi bootstrap.mjs --apply --enable xong
CARENEST_AUTH_ENABLED=false
# Gateway secret >= 32 ký tự; hai khóa sau là 32 byte mã hóa base64, độc lập nhau
KEYCLOAK_AUTH_GATEWAY_CLIENT_SECRET=change-me
CARENEST_AUTH_ENCRYPTION_KEY=change-me
KEYCLOAK_AUTH_RECOVERY_ASSERTION_SECRET=change-me

# Trợ lý AI (AI-09: Gemini hoặc Groq, endpoint OpenAI-compatible); để trống khóa ⇒ AI tắt (AI-03)
CARENEST_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CARENEST_AI_API_KEY=
CARENEST_AI_MODEL=gemini-2.5-flash
CARENEST_AI_ENABLED=true
# Tên cũ AI_* vẫn được đọc khi không đặt CARENEST_AI_*
# AI (ADR-0007): AI_ENABLED=true và ít nhất một provider có model + key; thiếu ⇒ phương án không AI (AI-03).
# Gemini chỉ dùng cho task không có dữ liệu trẻ (thực đơn, kế hoạch giáo dục); Groq dùng được cho dữ liệu trẻ (AI-04)
AI_ENABLED=false
AI_GEMINI_MODEL=
AI_GEMINI_API_KEY=
AI_GROQ_MODEL=
AI_GROQ_API_KEY=
# Embedding xếp lại món ứng viên (AI-06), vd. gemini-embedding-001; trống ⇒ bỏ qua
AI_EMBEDDING_MODEL=
AI_EMBEDDING_API_KEY=
