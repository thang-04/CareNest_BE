# Mẫu .env cho VPS (compose.vps.yaml). Trên VPS: chép thành /data/thangnd/CAPSTONE/CareNest_BE/.env, điền giá trị, chmod 600.
# Không commit .env. Secret: chuỗi ngẫu nhiên (`openssl rand -base64 32`), không dùng lại giá trị của máy dev.
# API_IMAGE / KEYCLOAK_IMAGE do CI truyền khi deploy; chỉ đặt tay khi rollback (docs/system/DEPLOYMENT.md).

# PostgreSQL
POSTGRES_DB=carenest
POSTGRES_USER=carenest
POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# Keycloak
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
# Secret client carenest-backend (Admin API); >= 32 ký tự
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
# Mật khẩu chung user dev — chỉ giai đoạn seed demo; đặt mạnh vì site ra Internet
KEYCLOAK_DEV_USER_PASSWORD=change-me
CARENEST_MOBILE_REDIRECT_URI=carenest://oauth/callback
# Bỏ comment khi dùng SMTP thật; mặc định Mailpit cùng VPS (127.0.0.1:18340)
# CARENEST_SMTP_HOST=
# CARENEST_SMTP_PORT=

# API
# dev = nạp dữ liệu giả; đặt rỗng (SPRING_PROFILES_ACTIVE=) khi chuyển dữ liệu thật
SPRING_PROFILES_ACTIVE=dev

# React auth gateway (ADR-0013): để false tới khi bootstrap.mjs --apply --enable xong
CARENEST_AUTH_ENABLED=false
# Gateway secret >= 32 ký tự; hai khóa sau là 32 byte mã hóa base64, độc lập nhau
KEYCLOAK_AUTH_GATEWAY_CLIENT_SECRET=change-me
CARENEST_AUTH_ENCRYPTION_KEY=change-me
KEYCLOAK_AUTH_RECOVERY_ASSERTION_SECRET=change-me
