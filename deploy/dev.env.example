# Mẫu .env cho môi trường dev (compose.dev.yaml). Trên VPS: /data/thangnd/CAPSTONE/CareNest_BE-dev/.env, chmod 600.
# Mọi secret sinh riêng cho dev (`openssl rand -hex 32`), không dùng lại giá trị production.
# DB/role dev tạo một lần trên Postgres production (docs/system/DEPLOYMENT.md mục Môi trường dev).
# API_IMAGE / KEYCLOAK_IMAGE do CI truyền khi deploy.

# Role carenest_dev (DB carenest_dev) và keycloak_dev (DB keycloak_dev)
POSTGRES_DB=carenest_dev
POSTGRES_USER=carenest_dev
POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# Keycloak dev
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
# Secret client carenest-backend (Admin API); >= 32 ký tự
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
# Mật khẩu chung 8 user demo trên dev; chỉ áp khi Keycloak dev import realm lần đầu
KEYCLOAK_DEV_USER_PASSWORD=change-me
CARENEST_MOBILE_REDIRECT_URI=carenest://oauth/callback

# API dev
SPRING_PROFILES_ACTIVE=dev
# false tới khi bootstrap.mjs --apply --enable trên Keycloak dev xong
CARENEST_AUTH_ENABLED=false
KEYCLOAK_AUTH_GATEWAY_CLIENT_SECRET=change-me
CARENEST_AUTH_ENCRYPTION_KEY=change-me
KEYCLOAK_AUTH_RECOVERY_ASSERTION_SECRET=change-me

# Kho tệp S3 (docs/system/EDUCATION_MEDIA_S3.md); CORS bucket phải có https://dev.carenest.edu.vn
CARENEST_EDUCATION_MEDIA_BUCKET=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SMS: fake = không gửi thật; textbee = điện thoại Android gửi bằng SIM (thiếu API key ⇒ API không khởi động)
CARENEST_SMS_PROVIDER=fake
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Email từ BE: log = không gửi; smtp = Gmail App Password. Email Keycloak dev vẫn đi Mailpit (tunnel 18341)
CARENEST_EMAIL_PROVIDER=log
CARENEST_EMAIL_SMTP_USERNAME=
CARENEST_EMAIL_SMTP_PASSWORD=
CARENEST_EMAIL_FROM=

# Trợ lý AI (OpenAI-compatible); khóa trống ⇒ AI tắt. Groq: https://api.groq.com/openai/v1
CARENEST_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CARENEST_AI_MODEL=gemini-2.0-flash
CARENEST_AI_API_KEY=
